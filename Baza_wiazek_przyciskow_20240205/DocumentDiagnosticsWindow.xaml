<Window x:Class="Baza_wiazek_przyciskow_20240205.DocumentDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostyka dokumentu"
        Width="760"
        Height="560"
        MinWidth="640"
        MinHeight="460"
        Icon="icons8-connector-25.ico"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleTextBlock"
                       Text="Diagnostyka dokumentu"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource InkBrush}" />
            <TextBlock x:Name="SubtitleTextBlock"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedInkBrush}" />
        </StackPanel>

        <TextBox x:Name="DiagnosticsTextBox"
                 Grid.Row="2"
                 Padding="14"
                 AcceptsReturn="True"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Background="{DynamicResource SurfaceBrush}"
                 BorderBrush="{DynamicResource BorderBrushSoft}"
                 Foreground="{DynamicResource InkBrush}" />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource GhostButtonStyle}"
                    Content="Otwórz folder bazowy"
                    Click="OpenBaseFolder_Click" />

            <Button Grid.Column="2"
                    Style="{StaticResource GhostButtonStyle}"
                    Content="Kopiuj raport"
                    Click="CopyReport_Click" />

            <Button Grid.Column="4"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="Zamknij"
                    Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
