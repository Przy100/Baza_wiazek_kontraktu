<Window x:Class="Baza_wiazek_przyciskow_20240205.LinkSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ścieżki programu"
        Width="820"
        Height="560"
        MinWidth="720"
        MinHeight="500"
        Icon="icons8-connector-25.ico"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="PathTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="24" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Wymagane ścieżki"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource InkBrush}" />
            <TextBlock Text="Te ustawienia sterują wyborem pliku LW, odczytem danych pomocniczych i budowaniem linków do dokumentacji."
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedInkBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Katalog startowy list LW"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}" />
                        <TextBlock Text="Folder, który program pokaże jako pierwszy po kliknięciu „Wskaż listę wiązek kontraktu”."
                                   Margin="0,4,0,10"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedInkBrush}" />
                        <TextBox x:Name="InitialDirectoryTextBox"
                                 Style="{StaticResource PathTextBoxStyle}" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Plik DATA"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}" />
                        <TextBlock Text="Plik Excela z arkuszem „Folder”; program używa go do zamiany typu wiązki na właściwy katalog dokumentacji."
                                   Margin="0,4,0,10"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedInkBrush}" />
                        <TextBox x:Name="FilePathDataTextBox"
                                 Style="{StaticResource PathTextBoxStyle}" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="Główny katalog dokumentacji"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}" />
                        <TextBlock Text="Początek ścieżki, do którego program dokleja folder, nazwę dokumentu i numer BTE, aby otworzyć konkretną wiązkę albo płytę."
                                   Margin="0,4,0,10"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedInkBrush}" />
                        <TextBox x:Name="StartPathTextBox"
                                 Style="{StaticResource PathTextBoxStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource GhostButtonStyle}"
                    Content="Przywróć domyślne"
                    Click="RestoreDefaults_Click" />

            <Button Grid.Column="2"
                    Style="{StaticResource GhostButtonStyle}"
                    Content="Anuluj"
                    Click="Cancel_Click" />

            <Button Grid.Column="4"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="Zapisz"
                    Click="Save_Click" />
        </Grid>
    </Grid>
</Window>
