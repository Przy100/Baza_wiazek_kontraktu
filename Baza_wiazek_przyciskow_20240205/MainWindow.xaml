<Window x:Class="Baza_wiazek_przyciskow_20240205.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Baza_wiazek_przyciskow_20240205"
        Title="Baza wiązek kontraktu"
        Width="1440"
        Height="820"
        MinWidth="1100"
        MinHeight="680"
        Icon="icons8-connector-25.ico"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                Effect="{StaticResource PanelShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource IconCircleStyle}">
                            <TextBlock Text="LW"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Baza wiązek kontraktu"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkBrush}" />
                            <TextBlock Text="Wczytaj listę LW, sprawdź statusy i otwieraj dokumentację bez szukania po katalogach."
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource MutedInkBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Menu VerticalAlignment="Center">
                            <MenuItem x:Name="RecentFilesMenuItem" Header="Ostatnio otwierane" />
                            <MenuItem Header="Opcje">
                                <MenuItem Header="Ścieżki programu" Click="ConfigureLinks_Click" />
                                <Separator />
                                <MenuItem Header="Motyw kolorów">
                                    <MenuItem x:Name="ThemeLightFreshMenuItem"
                                              Header="Jasny Fresh"
                                              Tag="LightFresh"
                                              IsCheckable="True"
                                              Click="ThemeMenuItem_Click" />
                                    <MenuItem x:Name="ThemeLightWarmMenuItem"
                                              Header="Jasny Warm"
                                              Tag="LightWarm"
                                              IsCheckable="True"
                                              Click="ThemeMenuItem_Click" />
                                    <Separator />
                                    <MenuItem x:Name="ThemeDarkGraphiteMenuItem"
                                              Header="Ciemny Graphite"
                                              Tag="DarkGraphite"
                                              IsCheckable="True"
                                              Click="ThemeMenuItem_Click" />
                                    <MenuItem x:Name="ThemeDarkNordMenuItem"
                                              Header="Ciemny Nord"
                                              Tag="DarkNord"
                                              IsCheckable="True"
                                              Click="ThemeMenuItem_Click" />
                                </MenuItem>
                                <MenuItem Header="Otwórz aktualny plik LW" Click="OpenCurrentFile_Click" />
                            </MenuItem>
                        </Menu>
                        <Border Width="1"
                                Height="24"
                                Margin="14,0"
                                Background="{DynamicResource BorderBrushSoft}" />
                        <TextBlock x:Name="VersionTextBlock"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedInkBrush}"
                                   FontWeight="SemiBold"
                                   Text="v2.3.1" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="ChooseFile_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+"
                                       FontSize="16"
                                       Margin="0,0,8,1" />
                            <TextBlock Text="Wskaż listę wiązek kontraktu" />
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="2"
                            Background="{DynamicResource SurfaceMutedBrush}"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="FileNameTextBlock"
                                           Text="Nie wybrano pliku LW"
                                           TextTrimming="CharacterEllipsis"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}" />
                                <TextBlock x:Name="RowCountTextBlock"
                                           Grid.Column="1"
                                           Margin="16,0,0,0"
                                           Foreground="{DynamicResource MutedInkBrush}"
                                           Text="0 pozycji" />
                            </Grid>
                            <ProgressBar x:Name="ImportProgressBar"
                                         Grid.Row="2"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="4"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock Text="Created by Szymon Wojciechowski"
                                   Foreground="{DynamicResource MutedInkBrush}"
                                   TextAlignment="Right" />
                        <TextBlock x:Name="StatusTextBlock"
                                   Margin="0,4,0,0"
                                   Text="Gotowe"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="1"
                Effect="{StaticResource PanelShadow}">
            <Grid>
                <DataGrid x:Name="DocumentsGrid"
                          ItemsSource="{Binding Documents}"
                          AlternationCount="2"
                          IsReadOnly="True"
                          EnableRowVirtualization="True"
                          ClipboardCopyMode="IncludeHeader"
                          SelectionMode="Extended"
                          SelectionUnit="CellOrRowHeader">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Kopiuj"
                                      Command="Copy"
                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="44" CanUserResize="False" ClipboardContentBinding="{Binding DocumentAvailability}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Revision, StringFormat=Rewizja: {0}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="3"
                                                Height="32"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                CornerRadius="2"
                                                Background="{Binding Revision, Converter={StaticResource RevisionToBrushConverter}}" />

                                        <Button Grid.Column="1"
                                                Style="{StaticResource StatusIndicatorButtonStyle}"
                                                ToolTip="{Binding DocumentAvailabilityDetails}"
                                                Click="ShowDocumentDiagnostics_Click">
                                            <Grid Width="16" Height="16">
                                                <Ellipse Fill="{Binding DocumentAvailability, Converter={StaticResource DocumentAvailabilityToBrushConverter}}"
                                                         Opacity="0.82" />
                                                <TextBlock Text="!"
                                                           Foreground="White"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanOpenDocument}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Lp." Binding="{Binding Number}" Width="64">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.CellStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Numer wiązki BTE" Width="160" ClipboardContentBinding="{Binding BteNumber}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <local:RichTextBlock Value="{Binding BteNumberText}"
                                                         TextWrapping="Wrap"
                                                         VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Typ dokumentu" Width="170" ClipboardContentBinding="{Binding DocumentKind}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ChipButtonStyle}"
                                            Margin="0,4"
                                            Click="OpenDocument_Click"
                                            ToolTip="{Binding LinkPath}">
                                        <local:RichTextBlock Value="{Binding DocumentKindText}" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Indeks SBC" Width="150" ClipboardContentBinding="{Binding SbcIndex}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <local:RichTextBlock Value="{Binding SbcIndexText}"
                                                         TextWrapping="Wrap"
                                                         VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Ilość" Width="78" ClipboardContentBinding="{Binding Quantity}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <local:RichTextBlock Value="{Binding QuantityText}"
                                                         TextWrapping="Wrap"
                                                         VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Priorytet" Width="115" ClipboardContentBinding="{Binding Priority}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <local:RichTextBlock Value="{Binding PriorityText}"
                                                         TextWrapping="Wrap"
                                                         VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Status" Width="135" ClipboardContentBinding="{Binding Status}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <local:RichTextBlock Value="{Binding StatusText}"
                                                         TextWrapping="Wrap"
                                                         VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Rewizja" Width="105" ClipboardContentBinding="{Binding Revision}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <local:RichTextBlock Value="{Binding RevisionText}"
                                                         TextWrapping="Wrap"
                                                         VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Opis / zastosowanie" Width="2*" ClipboardContentBinding="{Binding Description}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <local:RichTextBlock Value="{Binding DescriptionText}"
                                                         TextWrapping="Wrap"
                                                         VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Uwagi" Width="*" ClipboardContentBinding="{Binding Notes}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <local:RichTextBlock Value="{Binding NotesText}"
                                                         TextWrapping="Wrap"
                                                         VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border x:Name="EmptyStatePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource GridHeaderBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="28,22">
                    <StackPanel Width="360">
                        <TextBlock Text="Wybierz plik LW"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource InkBrush}" />
                        <TextBlock Text="Po wczytaniu arkusza tabela pokaże numery BTE, statusy, priorytety i przyciski do dokumentacji."
                                   Margin="0,8,0,0"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedInkBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
