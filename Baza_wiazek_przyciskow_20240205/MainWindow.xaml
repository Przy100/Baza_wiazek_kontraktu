<Window x:Class="Baza_wiazek_przyciskow_20240205.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Baza wiązek kontraktu"
        Width="1440"
        Height="820"
        MinWidth="1100"
        MinHeight="680"
        Icon="icons8-connector-25.ico"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                Effect="{StaticResource PanelShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource IconCircleStyle}">
                            <TextBlock Text="LW"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Baza wiązek kontraktu"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkBrush}" />
                            <TextBlock Text="Wczytaj listę LW, sprawdź statusy i otwieraj dokumentację bez szukania po katalogach."
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource MutedInkBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Menu VerticalAlignment="Center">
                            <MenuItem x:Name="RecentFilesMenuItem" Header="Ostatnio otwierane" />
                            <MenuItem Header="Opcje">
                                <MenuItem Header="Ścieżki programu" Click="ConfigureLinks_Click" />
                                <Separator />
                                <MenuItem Header="Motyw kolorów">
                                    <MenuItem x:Name="ThemeLightFreshMenuItem"
                                              Header="Jasny Fresh"
                                              Tag="LightFresh"
                                              IsCheckable="True"
                                              Click="ThemeMenuItem_Click" />
                                    <MenuItem x:Name="ThemeLightWarmMenuItem"
                                              Header="Jasny Warm"
                                              Tag="LightWarm"
                                              IsCheckable="True"
                                              Click="ThemeMenuItem_Click" />
                                    <Separator />
                                    <MenuItem x:Name="ThemeDarkGraphiteMenuItem"
                                              Header="Ciemny Graphite"
                                              Tag="DarkGraphite"
                                              IsCheckable="True"
                                              Click="ThemeMenuItem_Click" />
                                    <MenuItem x:Name="ThemeDarkNordMenuItem"
                                              Header="Ciemny Nord"
                                              Tag="DarkNord"
                                              IsCheckable="True"
                                              Click="ThemeMenuItem_Click" />
                                </MenuItem>
                                <MenuItem Header="Otwórz aktualny plik LW" Click="OpenCurrentFile_Click" />
                            </MenuItem>
                        </Menu>
                        <Border Width="1"
                                Height="24"
                                Margin="14,0"
                                Background="{DynamicResource BorderBrushSoft}" />
                        <TextBlock x:Name="VersionTextBlock"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedInkBrush}"
                                   FontWeight="SemiBold"
                                   Text="v2.3.1" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="ChooseFile_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+"
                                       FontSize="16"
                                       Margin="0,0,8,1" />
                            <TextBlock Text="Wskaż listę wiązek kontraktu" />
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="2"
                            Background="{DynamicResource SurfaceMutedBrush}"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="FileNameTextBlock"
                                           Text="Nie wybrano pliku LW"
                                           TextTrimming="CharacterEllipsis"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}" />
                                <TextBlock x:Name="RowCountTextBlock"
                                           Grid.Column="1"
                                           Margin="16,0,0,0"
                                           Foreground="{DynamicResource MutedInkBrush}"
                                           Text="0 pozycji" />
                            </Grid>
                            <ProgressBar x:Name="ImportProgressBar"
                                         Grid.Row="2"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="4"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock Text="Created by Szymon Wojciechowski"
                                   Foreground="{DynamicResource MutedInkBrush}"
                                   TextAlignment="Right" />
                        <TextBlock x:Name="StatusTextBlock"
                                   Margin="0,4,0,0"
                                   Text="Gotowe"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="1"
                Effect="{StaticResource PanelShadow}">
            <Grid>
                <DataGrid x:Name="DocumentsGrid"
                          ItemsSource="{Binding Documents}"
                          AlternationCount="2"
                          IsReadOnly="True"
                          EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Lp." Binding="{Binding Number}" Width="64" />
                        <DataGridTextColumn Header="Numer wiązki BTE" Binding="{Binding BteNumber}" Width="160" />
                        <DataGridTemplateColumn Header="Typ dokumentu" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ChipButtonStyle}"
                                            Content="{Binding DocumentKind}"
                                            Click="OpenDocument_Click"
                                            ToolTip="{Binding LinkPath}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Indeks SBC" Binding="{Binding SbcIndex}" Width="150" />
                        <DataGridTextColumn Header="Ilość" Binding="{Binding Quantity}" Width="78" />
                        <DataGridTextColumn Header="Priorytet" Binding="{Binding Priority}" Width="115" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="135" />
                        <DataGridTextColumn Header="Rewizja" Binding="{Binding Revision}" Width="105" />
                        <DataGridTextColumn Header="Opis / zastosowanie" Binding="{Binding Description}" Width="2*" />
                        <DataGridTextColumn Header="Uwagi" Binding="{Binding Notes}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border x:Name="EmptyStatePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource GridHeaderBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="28,22">
                    <StackPanel Width="360">
                        <TextBlock Text="Wybierz plik LW"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource InkBrush}" />
                        <TextBlock Text="Po wczytaniu arkusza tabela pokaże numery BTE, statusy, priorytety i przyciski do dokumentacji."
                                   Margin="0,8,0,0"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedInkBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
